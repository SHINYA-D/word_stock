{
  "permissions": {
    "allow": [
      "Bash",
      "Glob",
      "Grep",
      "Read(//Users/a12345/StudioProjects/word_stock/**)",
      "Edit(//Users/a12345/StudioProjects/word_stock/**)",
      "Write(//Users/a12345/StudioProjects/word_stock/**)",
      "Read(//private/tmp/claude-501/**)",
      "Edit(//private/tmp/claude-501/**)",
      "Write(//private/tmp/claude-501/**)",
      "Read(//tmp/claude-501/**)",
      "Edit(//tmp/claude-501/**)",
      "Write(//tmp/claude-501/**)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(android/key.properties)",
      "Read(android/app/src/*/google-services.json)",
      "Read(ios/Runner/GoogleService-Info.plist)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(cat .env:*)",
      "Bash(printenv)",
      "Bash(env)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(firebase:*)",
      "Bash(flutterfire:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(bq:*)",
      "Bash(aws:*)",
      "Bash(stripe:*)",
      "Bash(npm publish:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block_direct_flutter_test.sh",
            "statusMessage": "テスト実行方法を確認中..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/require_test_loop_skill.sh",
            "statusMessage": "test-loop手順書の読み込みを確認中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block_generated_file_edit.sh",
            "statusMessage": "生成ファイルへの変更でないか確認中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/require_test_loop_completion.py",
            "statusMessage": "テスト工程が完了しているか確認中..."
          }
        ]
      }
    ]
  }
}
