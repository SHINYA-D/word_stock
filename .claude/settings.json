{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(android/key.properties)",
      "Read(android/app/src/*/google-services.json)",
      "Read(ios/Runner/GoogleService-Info.plist)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(cat .env*)",
      "Bash(cat **/google-services.json)",
      "Bash(cat **/key.properties)",
      "Bash(printenv)",
      "Bash(env)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block_direct_flutter_test.sh",
            "statusMessage": "テスト実行方法を確認中..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/require_test_loop_skill.sh",
            "statusMessage": "test-loop手順書の読み込みを確認中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/block_generated_file_edit.sh",
            "statusMessage": "生成ファイルへの変更でないか確認中..."
          }
        ]
      }
    ]
  }
}
